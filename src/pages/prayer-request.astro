---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="Prayer Desk"
  description="Submit confidential prayer requests to the Kenya Coast Field intercessory prayer ministry team."
>
  <Header />

  <main class="flex-grow">
    <!-- Header Banner -->
    <div class="bg-gradient-to-r from-[#082347] to-[#003366] text-white py-12 px-4 sm:px-8 border-b border-white/10">
      <div class="max-w-4xl mx-auto">
        <span class="text-amber-400 font-bold uppercase tracking-wider text-xs">Intercessory Ministry</span>
        <h1 class="text-3xl sm:text-4xl font-serif font-bold mt-1 mb-2">Kenya Coast Field Prayer Desk</h1>
        <p class="text-slate-300 text-sm sm:text-base">
          "The prayer of a righteous person is powerful and effective." — James 5:16
        </p>
      </div>
    </div>

    <!-- Main Content -->
    <div class="max-w-4xl mx-auto px-4 sm:px-8 py-10">
      <div class="grid md:grid-cols-3 gap-8">
        <!-- Form Column -->
        <div class="md:col-span-2 bg-white p-6 sm:p-8 rounded-2xl border border-slate-200 shadow-sm">
          <h2 class="text-xl font-serif font-bold text-[#003366] mb-1">Submit Your Prayer Request</h2>
          <p class="text-xs text-slate-500 mb-6">
            All requests sent here are handled with confidentiality and shared only with our designated pastors and prayer intercessors.
          </p>

          <form id="prayer-form" class="space-y-4">
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label for="name" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Your Name (Optional)</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  placeholder="Anonymous or Your Name"
                  class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-adventist-blue focus:border-adventist-blue focus:outline-none"
                />
              </div>
              <div>
                <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Phone / WhatsApp (Optional)</label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  placeholder="e.g. +254 700 000000"
                  class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-adventist-blue focus:border-adventist-blue focus:outline-none"
                />
              </div>
            </div>

            <div>
              <label for="category" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Prayer Category</label>
              <select
                id="category"
                name="category"
                class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm bg-white focus:ring-2 focus:ring-adventist-blue focus:border-adventist-blue focus:outline-none"
              >
                <option value="healing">Health & Healing</option>
                <option value="family">Family & Marriage</option>
                <option value="spiritual">Spiritual Growth & Repentance</option>
                <option value="career">Employment & Business</option>
                <option value="bereavement">Comfort in Bereavement</option>
                <option value="thanksgiving">Praise & Thanksgiving</option>
                <option value="other">General Intercession</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Your Petition / Prayer Needs *</label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                placeholder="Share your prayer burdens or praises here..."
                class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-adventist-blue focus:border-adventist-blue focus:outline-none"
              ></textarea>
            </div>

            <div class="flex items-center gap-2">
              <input type="checkbox" id="confidential" name="confidential" checked class="rounded border-slate-300 text-adventist-blue focus:ring-adventist-blue" />
              <label for="confidential" class="text-xs text-slate-600">Keep this request strictly confidential between pastors</label>
            </div>

            <button
              type="submit"
              class="w-full py-3 rounded-lg bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold text-sm transition shadow-sm cursor-pointer"
            >
              Submit Prayer Request 🙏
            </button>
          </form>

          <div id="success-alert" class="hidden mt-4 p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-lg text-sm text-center font-medium">
            ✨ Thank you. Your prayer request has been received. Our prayer team will lift you up in intercession.
          </div>
        </div>

        <!-- Sidebar Column -->
        <div class="space-y-6">
          <div class="bg-[#003366] text-white p-6 rounded-2xl shadow-sm">
            <span class="text-amber-400 font-bold text-xs uppercase tracking-wider">Weekly Prayer Hour</span>
            <h3 class="text-lg font-serif font-bold mt-1 mb-2">Wednesday & Sabbath Prayer Band</h3>
            <p class="text-xs text-slate-300 leading-relaxed mb-4">
              Join local churches across Mombasa, Kilifi, and Kwale every Wednesday evening for corporate prayer and fasting.
            </p>
            <div class="border-t border-white/10 pt-3 text-xs font-mono text-amber-300">
              🕒 Wednesdays: 5:30 PM - 6:30 PM<br/>
              🕒 Sabbaths: 08:30 AM - 09:00 AM
            </div>
          </div>

          <div class="bg-amber-50 border border-amber-200 p-6 rounded-2xl">
            <h3 class="font-serif font-bold text-sm text-amber-900 mb-2">Direct Pastoral Counseling</h3>
            <p class="text-xs text-amber-800 leading-relaxed mb-3">
              If you require urgent pastoral care, contact the Field Executive Secretary:
            </p>
            <div class="text-xs font-semibold text-slate-900">
              📞 +254 (0) 724 931 090<br/>
              ✉️ prayer@kcf.adventist.or.ke
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  const form = document.getElementById('prayer-form') as HTMLFormElement;
  const alertBox = document.getElementById('success-alert');

  if (form && alertBox) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      form.reset();
      alertBox.classList.remove('hidden');
      setTimeout(() => {
        alertBox.classList.add('hidden');
      }, 5000);
    });
  }
</script>
