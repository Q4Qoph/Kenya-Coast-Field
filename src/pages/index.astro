---
// src/pages/index.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ChurchFinder from "../components/ChurchFinder.tsx";
import GivingWidget from "../components/GivingWidget.astro";
import ShekiRadioPlayer from "../components/ShekiRadioPlayer.tsx";
import CampMeetingCard from "../components/CampMeetingCard.astro";
import churches from "../data/churches.json";
import leadershipData from "../data/leadership.json";
import { getCollection } from "astro:content";

const campMeetings = (await getCollection("campMeetings")).sort(
  (a, b) => new Date(a.data.startDate).getTime() - new Date(b.data.startDate).getTime()
);
const upcomingCamps = campMeetings.slice(0, 3);
---

<BaseLayout
  title="Home"
  description="Official portal of the Seventh-day Adventist Church - Kenya Coast Field (EKUC). Coordinating mission, pastorates, camp meetings, and Sheki FM across coastal Kenya."
>
  <Header />

  <main class="flex-grow">
    <!-- 1. KCF COASTAL HERO SECTION (ALPS Banner Style matching ECD / TED) -->
    <section class="relative bg-gradient-to-r from-[#082347] via-[#2F557F] to-[#041a36] text-white py-16 sm:py-24 px-4 sm:px-8 border-b border-slate-200 overflow-hidden">
      <!-- Background Ambient Pattern -->
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,_var(--tw-gradient-stops))] from-blue-400/10 via-transparent to-transparent pointer-events-none"></div>

      <div class="max-w-6xl mx-auto space-y-6 text-center">
        <!-- Standard White Logo in Hero Banner (Matching ECD / ALPS) -->
        <div class="flex items-center justify-center gap-3.5 pb-1">
          <img
            src="/assets/sda/symbol/adventist-symbol--white.svg"
            alt="Seventh-day Adventist Church Symbol"
            class="h-14 sm:h-18 w-auto drop-shadow-md shrink-0"
          />
          <div class="flex flex-col items-start justify-center font-advent text-left leading-none">
            <span class="text-lg sm:text-2xl font-bold text-white tracking-tight leading-none drop-shadow-sm">
              Seventh-day
            </span>
            <span class="text-lg sm:text-2xl font-bold text-white tracking-tight leading-none mt-0.5 drop-shadow-sm">
              Adventist Church
            </span>
            <span class="text-[10px] sm:text-xs font-bold text-amber-300 uppercase tracking-[0.24em] leading-none mt-1.5 drop-shadow-xs">
              Kenya Coast Field • Est. 1986
            </span>
          </div>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif font-bold text-white tracking-tight uppercase max-w-4xl mx-auto leading-tight">
          Proclaiming the Everlasting Gospel Across Kenya’s Coastlands
        </h1>

        <p class="text-slate-200 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
          Coordinating Seventh-day Adventist pastorates, churches, camp meetings, and mission schools across 
          <strong>Mombasa, Kilifi, Kwale, Taita Taveta, Lamu, Tana River, Garissa, Mandera, and Wajir</strong>.
        </p>

        <!-- 4 Fast Action Buttons -->
        <div class="pt-3 flex flex-wrap items-center justify-center gap-3">
          <a
            href="#church-locator"
            class="px-5 py-2.5 rounded-full bg-white text-[#2F557F] hover:bg-slate-100 font-bold text-xs uppercase tracking-wider transition shadow-md"
          >
            📍 Find a Local Church
          </a>
          <a
            href="/camp-meetings"
            class="px-5 py-2.5 rounded-full bg-[#E36520] hover:bg-[#c95213] text-white font-bold text-xs uppercase tracking-wider transition shadow-md"
          >
            ⛺ 2026 Camp Meetings
          </a>
          <a
            href="/giving"
            class="px-5 py-2.5 rounded-full bg-white/15 hover:bg-white/25 text-white font-bold text-xs uppercase tracking-wider transition border border-white/30"
          >
            💳 E-Giving & Tithes
          </a>
          <a
            href="/prayer-request"
            class="px-5 py-2.5 rounded-full bg-white/15 hover:bg-white/25 text-white font-bold text-xs uppercase tracking-wider transition border border-white/30"
          >
            🙏 Prayer Desk
          </a>
        </div>

        <!-- Quick Stats Pill Strip -->
        <div class="pt-6 grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-3xl mx-auto text-xs font-mono">
          <div class="bg-black/30 backdrop-blur-xs p-3 rounded-xl border border-white/10 text-center">
            <div class="text-xl font-bold text-amber-300">9</div>
            <div class="text-[10px] text-slate-300 font-sans uppercase tracking-wider">Counties Covered</div>
          </div>
          <div class="bg-black/30 backdrop-blur-xs p-3 rounded-xl border border-white/10 text-center">
            <div class="text-xl font-bold text-amber-300">200+</div>
            <div class="text-[10px] text-slate-300 font-sans uppercase tracking-wider">Churches & Cos</div>
          </div>
          <div class="bg-black/30 backdrop-blur-xs p-3 rounded-xl border border-white/10 text-center">
            <div class="text-xl font-bold text-amber-300">45K+</div>
            <div class="text-[10px] text-slate-300 font-sans uppercase tracking-wider">Members</div>
          </div>
          <div class="bg-black/30 backdrop-blur-xs p-3 rounded-xl border border-white/10 text-center">
            <div class="text-xl font-bold text-amber-300">1934</div>
            <div class="text-[10px] text-slate-300 font-sans uppercase tracking-wider">First Mission</div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. WHO WE ARE & TERRITORY (ALPS Section Style matching ECD) -->
    <section class="max-w-7xl mx-auto px-4 sm:px-8 py-12">
      <div class="grid lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7 space-y-4">
          <div class="border-l-4 border-[#2F557F] pl-3">
            <h3 class="text-xs font-bold uppercase tracking-widest text-[#2F557F]">Who We Are</h3>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-900 mt-1">
              Serving the Coastlands & Northern Frontier
            </h2>
          </div>
          <p class="text-slate-600 text-sm leading-relaxed">
            The <strong>Kenya Coast Field (KCF)</strong> is an administrative unit of the Seventh-day Adventist Church operating under the <strong>East Kenya Union Conference (EKUC)</strong>. Tracing its heritage to pioneer missionary William Raitt in 1934 and officially organized in 1986, the Field oversees more than 200 congregations, schools, and health facilities.
          </p>
          <p class="text-slate-600 text-sm leading-relaxed">
            Our mission territory spans 9 diverse counties—from the historic Swahili coastline of Mombasa, Malindi, Lamu, and Diani, to the vast northern frontier communities of Garissa, Mandera, and Wajir.
          </p>
          <div class="pt-2 flex flex-wrap gap-3">
            <a
              href="/leadership"
              class="px-5 py-2 rounded-full bg-[#2F557F] hover:bg-[#234974] text-white text-xs font-bold uppercase tracking-wider transition"
            >
              Field Leadership Directory →
            </a>
            <a
              href="/ministries"
              class="px-5 py-2 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold uppercase tracking-wider transition border border-slate-200"
            >
              Ministries & Departments →
            </a>
          </div>
        </div>

        <!-- Headquarters Card -->
        <div class="lg:col-span-5">
          <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6 shadow-xs space-y-3">
            <div class="border-l-4 border-amber-500 pl-3">
              <span class="text-xs uppercase font-bold text-slate-500 tracking-wider">Field Headquarters</span>
              <h4 class="text-base font-serif font-bold text-[#2F557F]">Bamburi Mtambo Road, Mombasa</h4>
            </div>
            <div class="space-y-1.5 text-xs text-slate-600 pt-1">
              <p>📍 <strong>Physical Address:</strong> 2.7km from Bamburi Junction, Mombasa-Malindi Hwy</p>
              <p>📬 <strong>Postal Box:</strong> P.O. Box 80251 - 80100, Mombasa, Kenya</p>
              <p>📞 <strong>Phone:</strong> +254 (0) 724 561 850</p>
              <p>✉️ <strong>Email:</strong> info@kcf.adventist.or.ke</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. SHEKI FM RADIO BROADCAST (Live Audio Island) -->
    <section class="max-w-7xl mx-auto px-4 sm:px-8 py-6">
      <div class="border-l-4 border-[#2F557F] pl-3 mb-4">
        <h3 class="text-xs font-bold uppercase tracking-widest text-[#2F557F]">Broadcasting Hope</h3>
        <h2 class="text-2xl font-serif font-bold text-slate-900 mt-0.5">Sheki FM Coastal Radio</h2>
      </div>
      <ShekiRadioPlayer client:load />
    </section>

    <!-- 4. UPCOMING 2026 DISTRICT CAMP MEETINGS PREVIEW -->
    <section class="max-w-7xl mx-auto px-4 sm:px-8 py-10 border-t border-slate-200">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-6">
        <div class="border-l-4 border-[#2F557F] pl-3">
          <h3 class="text-xs font-bold uppercase tracking-widest text-[#2F557F]">Annual Convocations</h3>
          <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-900 mt-0.5">
            2026 District Camp Meetings
          </h2>
        </div>
        <a
          href="/camp-meetings"
          class="inline-flex items-center gap-1 text-xs font-bold text-[#2F557F] hover:text-[#E36520] transition uppercase tracking-wider"
        >
          View All Camp Schedules →
        </a>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {upcomingCamps.map((meeting) => (
          <CampMeetingCard meeting={meeting} />
        ))}
      </div>
    </section>

    <!-- 5. INTERACTIVE CHURCH & PASTOR DIRECTORY -->
    <section id="church-locator" class="max-w-7xl mx-auto px-4 sm:px-8 py-10 border-t border-slate-200">
      <div class="border-l-4 border-[#2F557F] pl-3 mb-6">
        <h3 class="text-xs font-bold uppercase tracking-widest text-[#2F557F]">Congregations Directory</h3>
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-900 mt-0.5">
          Coastal Congregations & Pastorates
        </h2>
        <p class="text-slate-600 text-xs mt-1">
          Locate your nearest Sabbath worship center or contact your District Pastor.
        </p>
      </div>

      <!-- React Island accepting JSON dataset props -->
      <ChurchFinder client:load churches={churches} />
    </section>

    <!-- 6. KCF EXECUTIVE OFFICERS HIGHLIGHT -->
    <section class="max-w-7xl mx-auto px-4 sm:px-8 py-10 border-t border-slate-200">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 mb-6">
        <div class="border-l-4 border-[#2F557F] pl-3">
          <h3 class="text-xs font-bold uppercase tracking-widest text-[#2F557F]">Administration</h3>
          <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-900 mt-0.5">
            Field Executive Leadership
          </h2>
        </div>
        <a
          href="/leadership"
          class="inline-flex items-center gap-1 text-xs font-bold text-[#2F557F] hover:text-[#E36520] transition uppercase tracking-wider"
        >
          View Full Directory →
        </a>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        {leadershipData.officers.map((officer) => (
          <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-xs flex flex-col justify-between hover:shadow-md transition">
            <div>
              <div class="flex items-center gap-3 mb-3">
                <div class="w-12 h-12 rounded-full bg-[#2F557F] text-amber-300 font-serif font-bold text-xl flex items-center justify-center shadow-xs shrink-0">
                  {officer.name.split(" ")[1]?.[0] || "P"}
                </div>
                <div>
                  <span class="text-[10px] uppercase tracking-wider font-bold text-slate-600 bg-slate-100 px-2 py-0.5 rounded border border-slate-200">
                    {officer.office}
                  </span>
                  <h3 class="font-serif font-bold text-base text-slate-900 leading-snug">{officer.name}</h3>
                  <p class="text-xs font-bold text-[#2F557F]">{officer.role}</p>
                </div>
              </div>
              <p class="text-xs text-slate-600 leading-relaxed mb-3">{officer.bio}</p>
            </div>

            <div class="border-t border-slate-100 pt-3 text-[11px] space-y-1 text-slate-500 font-mono">
              <p>✉️ <a href={`mailto:${officer.email}`} class="hover:text-[#2F557F] text-slate-700">{officer.email}</a></p>
              <p>📞 <span>{officer.phone}</span></p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 7. STEWARDSHIP & GIVING HUB -->
    <section class="max-w-7xl mx-auto px-4 sm:px-8 py-10 border-t border-slate-200">
      <div class="border-l-4 border-[#2F557F] pl-3 mb-6">
        <h3 class="text-xs font-bold uppercase tracking-widest text-[#2F557F]">Faithful Stewardship</h3>
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-900 mt-0.5">
          Support the Coastal Mission
        </h2>
      </div>
      <GivingWidget />
    </section>
  </main>

  <Footer />
</BaseLayout>
