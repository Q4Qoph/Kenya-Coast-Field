---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ChurchFinder from "../components/ChurchFinder.tsx";
import churches from "../data/churches.json";
---

<BaseLayout
  title="Find a Church"
  description="Locate a Seventh-day Adventist congregation or district across Mombasa, Kilifi, Kwale, Taita Taveta, Lamu, Tana River, and Garissa."
>
  <Header />

  <main class="flex-grow">
    <!-- Header Banner -->
    <div class="bg-gradient-to-r from-[#082347] to-[#003366] text-white py-12 px-4 sm:px-8 border-b border-white/10">
      <div class="max-w-7xl mx-auto">
        <span class="text-amber-400 font-bold uppercase tracking-wider text-xs">Directory & Locator</span>
        <h1 class="text-3xl sm:text-4xl font-serif font-bold mt-1 mb-2">Find a Seventh-day Adventist Church</h1>
        <p class="text-slate-300 text-sm sm:text-base max-w-2xl">
          Search over 200 organized congregations and mission companies across coastal Kenya. Filter by county or pastor.
        </p>
      </div>
    </div>

    <!-- Church Directory Component -->
    <div class="max-w-7xl mx-auto px-4 sm:px-8 py-10">
      <ChurchFinder client:load churches={churches} />
    </div>
  </main>

  <Footer />
</BaseLayout>
