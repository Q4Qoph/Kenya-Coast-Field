---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import departments from "../../data/departments.json";
---

<BaseLayout
  title="Ministries & Departments"
  description="Explore the departments and ministry wings serving the Kenya Coast Field of Seventh-day Adventists."
>
  <Header />

  <main class="flex-grow">
    <!-- Header Banner -->
    <div class="bg-gradient-to-r from-[#082347] to-[#003366] text-white py-12 px-4 sm:px-8 border-b border-white/10">
      <div class="max-w-7xl mx-auto">
        <span class="text-amber-400 font-bold uppercase tracking-wider text-xs">Departments & Service</span>
        <h1 class="text-3xl sm:text-4xl font-serif font-bold mt-1 mb-2">Field Ministries & Departments</h1>
        <p class="text-slate-300 text-sm sm:text-base max-w-2xl">
          Empowering coastal congregations through youth nurturing, evangelism, family enrichment, literature distribution, and holistic health.
        </p>
      </div>
    </div>

    <!-- Ministries Grid -->
    <div class="max-w-7xl mx-auto px-4 sm:px-8 py-12">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {departments.map((dept) => (
          <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm hover:shadow-md transition flex flex-col justify-between">
            <div>
              <div class="text-3xl mb-3">{dept.icon}</div>
              <h2 class="font-serif font-bold text-lg text-[#003366] mb-2">{dept.name}</h2>
              <p class="text-slate-600 text-sm leading-relaxed mb-4">{dept.description}</p>
            </div>
            <div class="border-t border-slate-100 pt-3 text-xs text-slate-500 font-medium flex justify-between items-center">
              <span>Director: <strong>{dept.director}</strong></span>
              <span class="text-adventist-ochre font-semibold">Active</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
